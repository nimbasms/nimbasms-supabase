# ─────────────────────────────────────────────────────────────────────────────
# Nimba SMS credentials — get them from https://app.nimbasms.com (Settings → API)
# ─────────────────────────────────────────────────────────────────────────────
NIMBA_SERVICE_ID=your_service_id_here
NIMBA_SECRET_TOKEN=your_secret_token_here

# Default Sender ID (must be approved in your Nimba SMS dashboard)
NIMBA_DEFAULT_SENDER=NimbaSMS

# Optional: override the API base URL (defaults to https://api.nimbasms.com/v1)
# NIMBA_API_BASE_URL=https://api.nimbasms.com/v1

# Optional: HTTP timeout for outbound calls in milliseconds (default 10000)
# NIMBA_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Webhook security — shared secret used to authenticate incoming delivery
# reports from Nimba SMS. Configure the same value in your Nimba dashboard.
# ─────────────────────────────────────────────────────────────────────────────
NIMBA_WEBHOOK_SECRET=replace_with_a_long_random_string

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — only needed for local examples; Edge Functions read these
# automatically from the platform.
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
